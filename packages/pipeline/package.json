{
  "name": "@novel2gal/pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./graph": "./src/graph.ts",
    "./state": "./src/state.ts",
    "./nodes/*": "./src/nodes/*.ts",
    "./routes": "./src/routes/index.ts",
    "./stages/*": "./src/stages/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langchain/core": "0.3.80",
    "@langchain/langgraph": "0.2.74",
    "@novel2gal/agents": "workspace:*",
    "@novel2gal/core": "workspace:*",
    "@novel2gal/ir": "workspace:^",
    "@novel2gal/providers": "workspace:*",
    "@novel2gal/rag": "workspace:*",
    "@novel2gal/storage": "workspace:*",
    "uuid": "^10.0.0",
    "zod": "^3.23.0",
    "@langchain/langgraph-checkpoint-sqlite": "0.1.4",
    "@langchain/langgraph-checkpoint": "0.0.18"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3"
  }
}
